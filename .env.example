# Canvas Chat API settings
CANVAS_CHAT_DATABASE_URL=sqlite:///./canvas_chat_2.db
CANVAS_CHAT_DEFAULT_PROVIDER_ID=default
CANVAS_CHAT_DEFAULT_LITELLM_MODEL=openai/gpt-4o-mini
CANVAS_CHAT_ENABLE_CANNED_AUTOREPLY=true
CANVAS_CHAT_CANNED_AUTOREPLY_TEXT="Canned AI reply: thanks for the message. Configure a provider to get model-generated responses."

# Example provider API keys (set only what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend API base (used by SvelteKit app)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
